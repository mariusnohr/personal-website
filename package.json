{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Marius Nohr – a collection of generative and interactive sketches.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "start": "tsx server/index.ts",
    "serve": "pnpm start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "history": "^5.3.0",
    "isotope-layout": "^3.0.6",
    "koa": "^3.2.1",
    "koa-static": "^5.0.0",
    "marked": "^18.0.14",
    "path-to-regexp": "^6.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/isotope-layout": "^3.0.15",
    "@types/koa": "^3.0.3",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^5.0.1"
  }
}
